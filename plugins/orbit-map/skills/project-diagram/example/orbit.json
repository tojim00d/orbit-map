{
  "title": "Orbit — the full project lifecycle",
  "subtitle": "Phases left to right, steps top to bottom. Each step produces an artifact — the next step's input.",
  "theme": "blueprint",
  "phases": [
    {"title": "Understand", "sub": "the task and the system before code", "steps": [
      {"id": "intake", "title": "Intake", "sub": "unambiguous requirements", "items": ["clarify-task", "shape-idea"]},
      {"id": "recon", "title": "Code recon", "sub": "knowledge graph, facts with file:line", "items": ["map-knowledge", "index-code", "survey-codebase"]},
      {"id": "reverse", "title": "Reverse engineering", "sub": "artifact, binary, API without docs", "items": ["reverse-app", "teardown-artifact"]},
      {"id": "spec", "title": "Specification", "sub": "spec before code", "items": ["write-spec", "run-spec-loop"]}]},
    {"title": "Build", "sub": "small steps with tests and checks", "steps": [
      {"id": "plan", "title": "Plan", "sub": "tasks of 2–5 minutes", "items": ["plan-steps", "slice-tickets"]},
      {"id": "build", "title": "Implementation", "sub": "test → code → refactor", "items": ["test-first"]},
      {"id": "check", "title": "Verification", "sub": "prove it works", "items": ["prove-done", "review-code"]},
      {"id": "release", "title": "Release", "sub": "MR and deploy", "items": ["open-mr", "ship-k8s"]}]},
    {"title": "Operate", "sub": "explain, remember, support", "steps": [
